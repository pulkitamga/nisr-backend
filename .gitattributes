# Auto-detect text files and normalize line endings
* text=auto
*.php text eol=lf
*.blade.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md text eol=lf

# Common binaries

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary


# Exclude from git archive exports (only affects git archive)
CHANGELOG.md export-ignore
